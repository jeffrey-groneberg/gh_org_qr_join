# ---------------------------------------------------------------------------
# Secrets & environment — never commit real credentials
# ---------------------------------------------------------------------------
.env
.env.*
*.env
secrets.*
*.secret
credentials.json
*.credentials

# Private keys & certificates
*.pem
*.key
*.pfx
*.p12
*.pkcs12
*.keystore
*.jks
id_rsa
id_dsa
id_ecdsa
id_ed25519

# ---------------------------------------------------------------------------
# Terraform (state can contain secrets; vars hold credentials)
# ---------------------------------------------------------------------------
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.auto.tfvars
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json

