# ---------------------------------------------------------------------------
# Secrets & environment — never commit real credentials
# ---------------------------------------------------------------------------
.env
.env.*
*.env
!.env.example
secrets.*
*.secret
credentials.json
*.credentials

# Private keys & certificates
*.pem
*.key
*.pfx
*.p12
*.pkcs12
*.keystore
*.jks
id_rsa
id_dsa
id_ecdsa
id_ed25519

# ---------------------------------------------------------------------------
# Databases (SQLite lives on /home in prod; never commit local data)
# ---------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# ---------------------------------------------------------------------------
# Terraform (state can contain secrets; vars hold credentials)
# ---------------------------------------------------------------------------
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.auto.tfvars
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
