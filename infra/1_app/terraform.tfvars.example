# Copy to terraform.tfvars and fill in. Do NOT commit terraform.tfvars.

# Leave app_name empty to auto-generate a globally-unique "<prefix>-<random>"
# name (recommended — run ./deploy.sh to learn it before configuring GitHub).
# Set it explicitly only if you want a fixed name.
# app_name        = "my-qr-org-join"
# app_name_prefix = "qr-org-join"

location  = "westeurope"
tenant_id = "00000000-0000-0000-0000-000000000000"

# GitHub OAuth App (participant identity) + classic PAT (admin:org) for invites.
# When auto-naming, fill these in after ./deploy.sh prints the callback URL.
github_client_id     = "Iv1xxxxxxxxxxxxxxxxx"
github_client_secret = "replace-me"
github_invite_token  = "ghp_replace_me"

# Optionally assign the admin app role to specific users at deploy time.
# admin_principal_object_ids = ["<user-object-id>"]

# Optional overrides:
# admin_app_role_value = "admin"
# sku_name             = "B1"
# app_base_url         = "https://<actual-host>"
