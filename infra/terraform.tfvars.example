# Copy to terraform.tfvars and fill in. Do NOT commit terraform.tfvars.

# Leave app_name empty to auto-generate a globally-unique "<prefix>-<random>"
# name (recommended — run ./deploy.sh to learn it before configuring GitHub).
# app_name = "my-qr-org-join"

location = "northeurope"

# Your public IP so Terraform can seed Key Vault secrets (the vault denies all
# other public traffic; the app reads secrets over the private endpoint).
operator_ip_cidr = "203.0.113.10/32"

# GitHub OAuth App (participant identity). Fill in after ./deploy.sh prints the
# callback URL when auto-naming.
github_client_id     = "Iv1xxxxxxxxxxxxxxxxx"
github_client_secret = "replace-me"

# GitHub App (least-privilege per-org invites + installation webhook). The
# webhook secret is generated by Terraform (see the github_webhook_secret output);
# the private key is read from a PEM file placed in this infra/ directory (default
# github-app.pem — see github_app_private_key_file), NOT pasted here.
github_app_id = "123456"

# Optional: override the PEM filename (default "github-app.pem", relative to infra/).
# github_app_private_key_file = "github-app.pem"

# Optional: assign the admin app role and/or Cosmos data access at deploy time.
# admin_principal_object_ids       = ["<user-object-id>"]
# cosmos_data_principal_object_ids = ["<user-object-id>"]
