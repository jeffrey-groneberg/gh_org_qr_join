# ---------------------------------------------------------------------------
# QR Org Join — environment configuration
# Copy this file to ".env" and fill in the values, then:  set -a; . ./.env; set +a
# ---------------------------------------------------------------------------

# Secret used to sign the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-with-a-long-random-hex-string

# Public base URL where this app is reachable (no trailing slash).
# Encoded in every QR code AND used to build the GitHub OAuth redirect_uri.
# For local testing use http://127.0.0.1:8000 (loopback is allowed by GitHub).
APP_BASE_URL=http://127.0.0.1:8000

# Cosmos DB (orgs store). Accessed passwordlessly with DefaultAzureCredential
# (your `az login` locally, the App Service managed identity in Azure). You need
# the "Cosmos DB Built-in Data Contributor" data role on the account — Terraform
# can grant it to you via cosmos_data_principal_object_ids. Get the endpoint from
# `terraform -chdir=infra output -raw cosmosdb_endpoint`.
COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
COSMOS_DATABASE=qrorgjoin
COSMOS_CONTAINER=orgs

# --- GitHub OAuth App (participant identity, empty scope) -------------------
# Create at: https://github.com/settings/developers
# Set the OAuth App "Authorization callback URL" to:  {APP_BASE_URL}/callback
GITHUB_CLIENT_ID=Iv1xxxxxxxxxxxxxxxxx
GITHUB_CLIENT_SECRET=replace-with-oauth-app-client-secret

# --- GitHub classic PAT used to create invitations for ALL orgs ------------
# Minimal scope required: admin:org (or write:org). The token owner must be an
# owner/admin of every org participants will join. If an org enforces SAML SSO,
# authorize the token for that org.
GITHUB_INVITE_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Admin authorization (via App Service Easy Auth app role) --------------
# Easy Auth (Entra ID) authenticates the admin at the platform level and injects
# their claims as request headers; configure it to "allow unauthenticated
# requests" so participants pass through. The app only needs the app-role name
# that grants admin access.
ENTRA_ADMIN_ROLE=admin

# Local-dev only: set to 1 to treat the local user as admin when there is no
# Easy Auth in front of the app. NEVER enable in production.
ADMIN_DEV_BYPASS=0

# --- Observability ----------------------------------------------------------
# Log level: DEBUG, INFO (default), WARNING, ERROR.
LOG_LEVEL=INFO
# Application Insights. Leave empty for local dev (telemetry is a no-op). On
# Azure, Terraform sets this automatically. Format:
#   InstrumentationKey=...;IngestionEndpoint=https://...
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Port the app listens on (default 8000).
PORT=8000
